# Gemini clinical extraction, clinical notes, and adaptive wording.
# This model is separate from plan-generation tuning.
GOOGLE_API_KEY=
CAREVOICE_AI_ENABLED=false
CAREVOICE_ADAPTIVE_QUESTIONS_ENABLED=false
GEMINI_MODEL=gemini-3.8-flash
CAREVOICE_AI_TIMEOUT_MS=12000

# Personalized plan generation. Off uses the deterministic generator.
# Do not point CAREVOICE_PLAN_BASE_MODEL at gemini-3.8-flash.
# Vertex tuned inference uses Application Default Credentials, not a key file in this repo.
CAREVOICE_PLAN_AI_ENABLED=false
CAREVOICE_PLAN_MODEL_PROVIDER=deterministic
CAREVOICE_PLAN_BASE_MODEL=gemini-3.5-flash
CAREVOICE_PLAN_TUNED_MODEL=
CAREVOICE_PLAN_PROJECT_ID=
CAREVOICE_PLAN_LOCATION=
CAREVOICE_PLAN_AI_TIMEOUT_MS=20000
CAREVOICE_PLAN_FALLBACK_TO_BASE=false

# Voice
CAREVOICE_VOICE_ENABLED=false
CAREVOICE_VOICE_PROVIDER=groq
CAREVOICE_VOICE_LANGUAGE=en
CAREVOICE_VOICE_MAX_FILE_SIZE_MB=20

# Groq Whisper. Set whisper-large-v3 when comparing transcription accuracy.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional Gemini transcription alternative
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

CAREVOICE_FRONTEND_ORIGIN=http://localhost:5173

# In-app daily reminders. Off unless you are testing the scheduler.
# This does not send SMS, email, or push notifications.
CAREVOICE_REMINDERS_ENABLED=false
CAREVOICE_REMINDER_SCAN_INTERVAL_MS=300000
CAREVOICE_REMINDER_WINDOW_MINUTES=240

# Demo/development clinician. Leave disabled unless you are creating a local doctor login.
# Do not commit a real password. An existing username is not overwritten on startup.
CAREVOICE_DEMO_CLINICIAN_ENABLED=false
CAREVOICE_DEMO_CLINICIAN_USERNAME=
CAREVOICE_DEMO_CLINICIAN_PASSWORD=
