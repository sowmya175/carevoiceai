# Gemini clinical extraction
GOOGLE_API_KEY=
CAREVOICE_AI_ENABLED=false
CAREVOICE_ADAPTIVE_QUESTIONS_ENABLED=false
GEMINI_MODEL=gemini-3.8-flash

# Voice
CAREVOICE_VOICE_ENABLED=false
CAREVOICE_VOICE_PROVIDER=groq
CAREVOICE_VOICE_LANGUAGE=en
CAREVOICE_VOICE_MAX_FILE_SIZE_MB=20

# Groq Whisper. Set whisper-large-v3 when comparing transcription accuracy.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional Gemini transcription alternative
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe

CAREVOICE_FRONTEND_ORIGIN=http://localhost:5173
